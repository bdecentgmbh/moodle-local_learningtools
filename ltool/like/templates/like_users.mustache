{{!
    @template ltool_like/like_users

    Capability-gated list of users grouped by reaction (manager modal).

    Example context (json):
    {
        "groups": [
            {"type": "like", "heading": "Liked this page", "count": 2, "hasusers": true,
             "users": [{"userpic": "<img src='https://moodle/pix/u/f2.png' alt='Jane Doe' class='userpicture'>", "fullname": "Jane Doe", "profileurl": "https://moodle/user"}]}
        ]
    }
}}
<div class="ltlike-users">
    {{#groups}}
    <section class="ltlike-users-group" aria-labelledby="ltlike-users-h-{{type}}">
        <h5 id="ltlike-users-h-{{type}}" class="ltlike-users-heading">
            {{heading}} <span class="badge bg-secondary badge-secondary">{{count}}</span>
        </h5>
        {{#hasusers}}
        <ul class="ltlike-users-list list-unstyled">
            {{#users}}
            <li class="ltlike-user d-flex align-items-center mb-2">
                <span class="ltlike-user-pic me-2 mr-2">{{{userpic}}}</span>
                <a href="{{profileurl}}" class="ltlike-user-name">{{fullname}}</a>
            </li>
            {{/users}}
        </ul>
        {{/hasusers}}
        {{^hasusers}}
        <p class="text-muted">{{#str}}noreactionusers, ltool_like{{/str}}</p>
        {{/hasusers}}
    </section>
    {{/groups}}
</div>
