{{!
    @template ltool_report/report

    The Learning Tools Report launcher button rendered into the FAB and drawer.

    Example context (json):
    {
        "ltoolreport": true,
        "icon": "fa fa-flag",
        "reporthovername": "Report an issue",
        "iconbackcolor": "#343a40",
        "iconcolor": "#ffffff",
        "contextid": 25,
        "pageurl": "https://moodle/course/view.php?id=2"
    }
}}
{{#ltoolreport}}
<div class="ltreportinfo" id="ltreportinfo" data-tool="report"
    data-contextid="{{contextid}}" data-pageurl="{{pageurl}}">
    <button type="button" class="ltreport-btn" id="ltreport-launcher"
        aria-haspopup="dialog" aria-label="{{reporthovername}}" title="{{reporthovername}}"
        {{#iconbackcolor}}style="background:{{iconbackcolor}};"{{/iconbackcolor}}>
        <i class="{{icon}}"{{#iconcolor}} style="color:{{iconcolor}};"{{/iconcolor}} aria-hidden="true"></i>
    </button>
    <p{{#iconbackcolor}} style="background:{{iconbackcolor}};color:{{iconcolor}};"{{/iconbackcolor}}>{{reporthovername}}</p>
</div>
{{/ltoolreport}}
