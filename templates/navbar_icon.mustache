{{!
    @template local_learningtools/navbar_icon

    Navbar toggle that opens the Learning Tools drawer (drawer launcher mode).

    Example context (json):
    {
        "icon": "fa fa-magic"
    }
}}
<div class="popover-region learningtools-navbar" data-region="learningtools-navbar">
    <a id="learningtools-drawer-toggle"
        class="nav-link position-relative icon-no-margin"
        href="#"
        role="button"
        aria-expanded="false"
        aria-label="{{#str}}togglelearningtools, local_learningtools{{/str}}"
        title="{{#str}}togglelearningtools, local_learningtools{{/str}}">
        <i class="icon {{icon}} fa-fw" aria-hidden="true"></i>
    </a>
</div>
